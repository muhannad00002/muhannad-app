# Copy to `.env` (git-ignored). Never commit real keys.

# Google Places API (New) + Geocoding — used for enrichment & verification.
GOOGLE_MAPS_API_KEY=

# Web search provider for public/Instagram discovery.
# Google Programmable Search (Custom Search JSON API):
#   SEARCH_API_KEY = your API key
#   SEARCH_ENGINE_ID = your Programmable Search Engine (cx) id
# Leave blank to disable automated discovery and use manual Instagram import.
SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# Database URL. Leave blank to use local SQLite at backend/data/vendors.db
# (recommended). Relative sqlite paths are resolved against the backend folder
# and the directory is created automatically, so it works from any terminal.
# Swap for PostgreSQL later, e.g. postgresql+psycopg://user:pass@host:5432/vendors
DATABASE_URL=

# CORS origins for the frontend (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
