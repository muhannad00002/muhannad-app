# Copy this file to `.env` and fill in your values.
# The .env file is git-ignored and must never be committed.

# --- Required ---------------------------------------------------------------
# Google Places API (New) key. Enable "Places API (New)" and "Geocoding API"
# in Google Cloud, then create an API key.
GOOGLE_API_KEY=

# --- Optional: search behaviour ---------------------------------------------
SEARCH_CITY=Muscat
SEARCH_COUNTRY=Oman
PAGE_SIZE=20
MAX_PAGES=10
LANGUAGE_CODE=en
REGION_CODE=OM
SEARCH_RADIUS_M=0

# --- Optional: performance --------------------------------------------------
MAX_WORKERS=10
REQUEST_TIMEOUT=30
MAX_RETRIES=5

# --- Optional: exports ------------------------------------------------------
EXPORT_EXCEL=true
EXPORT_CSV=true
EXPORT_JSON=false

# --- Optional: database -----------------------------------------------------
BACKUP_DATABASE=true
